# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUBMIT_LEAD_URL=https://YOUR_PROJECT.supabase.co/functions/v1/submit-lead
# Canonical site URL for Open Graph / robots / sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
# Cloudflare Turnstile site key (widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-only for Next.js (never NEXT_PUBLIC_* — not sent to the browser)
# Used by /api/submit-lead to verify Turnstile, then forward to Supabase.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Recommended: dedicated Next↔Edge proxy proof (same value as Supabase Edge secret).
# Falls back to TURNSTILE_SECRET_KEY if unset.
# LEAD_PROXY_SECRET=generate-with-openssl-rand-hex-32

# Server-only — set these as Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets).
# Never put these in NEXT_PUBLIC_* or ship them to the browser.
#
# REQUIRED for submit-lead / sync-enrollment (fail-closed Turnstile + CORS).
# TURNSTILE_SECRET_KEY must match the Next host secret.
# LEAD_PROXY_SECRET should match Next (falls back to TURNSTILE_SECRET_KEY if omitted).
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# LEAD_PROXY_SECRET=generate-with-openssl-rand-hex-32
#
# REQUIRED CORS allowlist (comma-separated). Browser admin + any direct Edge
# calls need an explicit origin. Next.js /api/submit-lead server proxy has no
# Origin header and still works when this is set.
# ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com,http://localhost:3000
#
# GOOGLE_SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Never put Sheets URL or SHEETS_WEBHOOK_SECRET in NEXT_PUBLIC_* / frontend.
#
# Generate a NEW Sheets secret (do not reuse any value that ever appeared in git):
#   openssl rand -hex 32
# Then: Apps Script → setWebhookSecret("…") and the same value below.
# SHEETS_WEBHOOK_SECRET=generate-a-long-random-string-at-least-32-chars
